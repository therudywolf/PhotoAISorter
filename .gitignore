# Virtual environments
.venv/
.venv-linux/
.venv*/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
.Python

# App data (local user presets and state — never commit personal tag lists)
*.sqlite3
context_tags.json
**/context_tags.json
local_presets.json
**/local_presets.json
category_aliases.json
**/category_aliases.json
gui_settings.json
**/gui_settings.json

# Local persistent data (refs, CLIP weights — next to project / install dir)
data/*
!data/README.txt

# Runtime cache (SQLite, hashes, WAL — keep on fast disk)
tmp/*
!tmp/README.txt

# Testing / linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Logs / temp
*.log
*.tmp

# Secrets / env
.env
.env.*
!.env.example

# IDE / editors
.vscode/
.idea/
.cursor/
*.swp
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Local app/runtime output
_review_runs/
duplicate_runs/

# FFmpeg local builds (don't commit binaries)
ffmpeg-runtime/
ffmpeg-essentials/
_ffmpeg*.zip
_ffmpeg_sdk_headers_only_backup/

# Internal planning docs (not for distribution)
docs/FIX_AND_IMPROVEMENT_PLAN.md

# --- secrets (security baseline; do not commit real credentials) ---
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.secret.example
!.env.local.example
!.env.mesh.example
!.env.prod.example
*.pem
*.key
